<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/custompage/db" VERSION="20261015" COMMENT="XMLDB file for Moodle local/custompage"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_custompages" COMMENT="Table to keep track and their details of custom pages">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="title to show in navigation, if null name field will be used"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="parent" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="parent page of this page"/>
        <FIELD NAME="depth" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="path" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sortthread" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="usercreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="iscontainer" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="showinprimarynav" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="show in primary navigation"/>
        <FIELD NAME="cardsummary" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="short summary shown on this page's card in its section"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="page body (for a section: intro shown above its cards)"/>
        <FIELD NAME="contentformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="audiencemode" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = same as its section, 1 = its own audiences"/>
        <FIELD NAME="designcss" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="design CSS as entered or imported"/>
        <FIELD NAME="designcsscompiled" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="design CSS scoped to this page"/>
        <FIELD NAME="look" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="built-in look of a resource hub"/>
        <FIELD NAME="ownerid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="person responsible for keeping the page up to date"/>
        <FIELD NAME="reviewby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="date the page should next be reviewed"/>
        <FIELD NAME="requireack" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = readers confirm they have read it (on a hub: every resource in it)"/>
        <FIELD NAME="ackversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="raised when readers must confirm again"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="custompage_par_ix" UNIQUE="false" FIELDS="parent"/>
        <INDEX NAME="cuspage_use_ix" UNIQUE="false" FIELDS="usercreated"/>
        <INDEX NAME="cuspage_use2_ix" UNIQUE="false" FIELDS="usermodified"/>
        <INDEX NAME="cuspage_con_ix" UNIQUE="false" FIELDS="contextid"/>
        <INDEX NAME="cuspage_own_ix" UNIQUE="false" FIELDS="ownerid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_custompage_audience" COMMENT="Who can see each custom page">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="19" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="heading" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="classname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="configdata" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="usercreated" TYPE="int" LENGTH="19" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="19" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="19" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="19" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cuspageaudi_page_ix" UNIQUE="false" FIELDS="pageid"/>
        <INDEX NAME="cuspageaudi_use_ix" UNIQUE="false" FIELDS="usercreated"/>
        <INDEX NAME="cuspageaudi_use2_ix" UNIQUE="false" FIELDS="usermodified"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_custompage_feedback" COMMENT="Was this page helpful? One answer per person per page">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="helpful" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = helpful, 0 = not helpful"/>
        <FIELD NAME="comment" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pageid" TYPE="foreign" FIELDS="pageid" REFTABLE="local_custompages" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="pageuser" UNIQUE="true" FIELDS="pageid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_custompage_ack" COMMENT="Confirmations that a person has read a page (one row per page version confirmed)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="version" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="the page's ackversion that was confirmed"/>
        <FIELD NAME="pagename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="the page's name when confirmed"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pageid" TYPE="foreign" FIELDS="pageid" REFTABLE="local_custompages" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="pageuserversion" UNIQUE="true" FIELDS="pageid, userid, version"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_custompage_standard" COMMENT="Standards a page addresses, for example RTO Standards 2025, 1.11, Student management">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="framework" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="for example RTO Standards 2025"/>
        <FIELD NAME="code" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="for example 1.11"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="for example Student management"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pageid" TYPE="foreign" FIELDS="pageid" REFTABLE="local_custompages" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
