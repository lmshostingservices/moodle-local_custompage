{{!
    @template local_custompage/page_actions

    Buttons for page managers at the top of a page or section.

    Example context (json):
    {"id": 3, "issection": true, "edithuburl": "#", "addresourceurl": "#", "manageurl": "#"}
}}
<div class="local-custompage-actions d-flex flex-wrap justify-content-end mb-3">
    {{#issection}}
        <a class="btn btn-primary mr-2 me-2 mb-2" href="{{edithuburl}}">{{#str}}edithubbutton, local_custompage{{/str}}</a>
        <a class="btn btn-secondary mr-2 me-2 mb-2" href="{{addresourceurl}}">{{#str}}addaresource, local_custompage{{/str}}</a>
    {{/issection}}
    {{^issection}}
        <button type="button" class="btn btn-primary mr-2 me-2 mb-2" data-action="local_custompage-edit" data-id="{{id}}">
            {{#str}}editpage, local_custompage{{/str}}
        </button>
    {{/issection}}
    <a class="btn btn-outline-secondary mb-2" href="{{manageurl}}">{{#str}}managecustompages, local_custompage{{/str}}</a>
</div>
{{#js}}
    require(['local_custompage/manage'], function(manage) {
        manage.init();
    });
{{/js}}
