{{!
    @template local_custompage/manage_row

    One row of the management list.

    Example context (json):
    {"id": 2, "name": "Marking guide", "url": "#", "issection": false, "inmenu": false,
     "audience": "Same as its hub", "owner": "Jamie Smith", "overdue": false, "reviewdate": "",
     "feedback": "", "feedbackurl": null, "canmoveup": true, "canmovedown": false, "childcount": 0,
     "editurl": null, "addurl": null}
}}
<tr data-page-id="{{id}}" class="{{#issection}}local-custompage-section-row{{/issection}}{{^issection}}local-custompage-page-row{{/issection}}">
    <td>
        {{#issection}}
            <span class="badge badge-secondary text-bg-secondary mr-2 me-2">{{#str}}hub, local_custompage{{/str}}</span>
            <a class="font-weight-bold fw-bold" href="{{url}}">{{{name}}}</a>
        {{/issection}}
        {{^issection}}
            <a class="local-custompage-page-link" href="{{url}}">{{{name}}}</a>
        {{/issection}}
    </td>
    <td class="small">{{audience}}</td>
    <td class="small">
        {{#owner}}<div>{{owner}}</div>{{/owner}}
        {{#overdue}}<div><span class="lcp-chip lcp-chip-warn">{{#str}}reviewoverdue, local_custompage, {{reviewdate}}{{/str}}</span></div>{{/overdue}}
        {{^overdue}}{{#reviewdate}}<div class="text-muted">{{#str}}reviewon, local_custompage, {{reviewdate}}{{/str}}</div>{{/reviewdate}}{{/overdue}}
        {{#feedbackurl}}<div><a href="{{feedbackurl}}">{{feedback}}</a></div>{{/feedbackurl}}
    </td>
    <td>{{#inmenu}}{{#pix}}i/checked, core, {{#str}}yes{{/str}}{{/pix}}{{/inmenu}}</td>
    <td class="text-right text-end text-nowrap">
        {{#editurl}}<a class="btn btn-sm btn-outline-primary" href="{{editurl}}">{{#str}}edit{{/str}}</a>{{/editurl}}
        {{^editurl}}<button type="button" class="btn btn-sm btn-outline-primary" data-action="local_custompage-edit" data-id="{{id}}">{{#str}}edit{{/str}}</button>{{/editurl}}
        {{#addurl}}<a class="btn btn-sm btn-outline-secondary" href="{{addurl}}">{{#str}}addaresource, local_custompage{{/str}}</a>{{/addurl}}
        <button type="button" class="btn btn-sm btn-link" data-action="local_custompage-move" data-direction="up" data-id="{{id}}" {{^canmoveup}}disabled{{/canmoveup}}
            title="{{#str}}moveup{{/str}}">{{#pix}}t/up, core, {{#str}}moveup{{/str}}{{/pix}}</button>
        <button type="button" class="btn btn-sm btn-link" data-action="local_custompage-move" data-direction="down" data-id="{{id}}" {{^canmovedown}}disabled{{/canmovedown}}
            title="{{#str}}movedown{{/str}}">{{#pix}}t/down, core, {{#str}}movedown{{/str}}{{/pix}}</button>
        <button type="button" class="btn btn-sm btn-link text-danger" data-action="local_custompage-delete" data-id="{{id}}"
            data-name="{{plainname}}" data-issection="{{#issection}}1{{/issection}}{{^issection}}0{{/issection}}" data-childcount="{{childcount}}"
            title="{{#str}}delete{{/str}}">{{#pix}}t/delete, core, {{#str}}delete{{/str}}{{/pix}}</button>
    </td>
</tr>
