{{!
    @template local_custompage/ack

    "I have read and understood this" for pages that ask readers to confirm.

    Example context (json):
    {
        "pageid": 3, "isnone": false, "isoutdated": true, "iscurrent": false,
        "confirmedtext": "You confirmed you read this on 15 October 2026, 10:32 AM.",
        "outdatedtext": "This page has changed since you confirmed it on 1 October 2026. Please read it again and confirm."
    }
}}
<section class="lcp-ack{{#iscurrent}} is-done{{/iscurrent}}" data-region="lcp-ack" data-pageid="{{pageid}}" aria-labelledby="lcp-ack-h-{{pageid}}">
    <h2 class="lcp-ack-title" id="lcp-ack-h-{{pageid}}">{{#str}}ack_title, local_custompage{{/str}}</h2>
    {{#iscurrent}}
        <p class="lcp-ack-done" role="status">{{#pix}}i/checkedcircle, core{{/pix}} {{confirmedtext}}</p>
    {{/iscurrent}}
    {{^iscurrent}}
        {{#isoutdated}}<p class="lcp-ack-note">{{outdatedtext}}</p>{{/isoutdated}}
        {{#isnone}}<p class="lcp-ack-note">{{#str}}ack_intro, local_custompage{{/str}}</p>{{/isnone}}
        <form class="lcp-ack-form">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lcp-ack-check-{{pageid}}" data-region="lcp-ack-check">
                <label class="form-check-label" for="lcp-ack-check-{{pageid}}">{{#str}}ack_statement, local_custompage{{/str}}</label>
            </div>
            <button type="submit" class="btn btn-primary" disabled>{{#str}}ack_confirm, local_custompage{{/str}}</button>
        </form>
        <p class="lcp-ack-done" role="status" aria-live="polite" hidden></p>
    {{/iscurrent}}
</section>
