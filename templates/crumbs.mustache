{{!
    @template local_custompage/crumbs

    Breadcrumb trail: where this page sits in the intranet. The last item is the current page and is not a link.

    Example context (json):
    {
        "crumbs": [{"name": "Intranet", "url": "#"}, {"name": "Trainer procedures", "url": null}]
    }
}}
<nav class="lcp-crumbs" aria-label="{{#str}}breadcrumb, local_custompage{{/str}}">
    <ol>
        {{#crumbs}}
            <li>{{#url}}<a href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}<span aria-current="page">{{{name}}}</span>{{/url}}</li>
        {{/crumbs}}
    </ol>
</nav>
