{{!
    @template local_custompage/wizard_steps

    Step indicator for the resource hub wizard.

    Example context (json):
    {"steps": [{"number": 1, "label": "Details", "current": false, "done": true, "url": "#"},
               {"number": 2, "label": "Resources", "current": true, "done": false, "url": null},
               {"number": 3, "label": "Look", "current": false, "done": false, "url": "#"}]}
}}
<ol class="local-custompage-steps list-unstyled d-flex flex-wrap mb-4">
    {{#steps}}
        <li class="local-custompage-step{{#current}} is-current{{/current}}{{#done}} is-done{{/done}}"{{#current}} aria-current="step"{{/current}}>
            {{#url}}<a href="{{url}}">{{/url}}
                <span class="local-custompage-step-number">{{number}}</span>
                <span class="local-custompage-step-label">{{label}}</span>
            {{#url}}</a>{{/url}}
        </li>
    {{/steps}}
</ol>
