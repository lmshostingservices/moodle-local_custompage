{{!
    @template local_custompage/manage_list

    Management list of sections and pages.

    Example context (json):
    {
        "hasitems": true, "createhuburl": "#", "prompturl": "#", "homeurl": "#", "settingsurl": "#",
        "items": [
            {"id": 1, "name": "Trainer Resources", "url": "#", "issection": true, "inmenu": true,
             "audience": "Role: Trainer", "canmoveup": false, "canmovedown": false, "haschildren": true, "childcount": 1,
             "children": [
                {"id": 2, "name": "Marking guide", "url": "#", "issection": false, "inmenu": false,
                 "audience": "Same as its section", "canmoveup": false, "canmovedown": false}
             ]}
        ]
    }
}}
<div class="local-custompage-manage">
    <div class="d-flex flex-wrap mb-3">
        <a class="btn btn-primary mr-2 me-2 mb-2" href="{{createhuburl}}" data-action-link="create-hub">
            {{#str}}createhub, local_custompage{{/str}}
        </a>
        <button type="button" class="btn btn-secondary mr-2 me-2 mb-2" data-action="local_custompage-new-page" data-parent="0">
            {{#str}}createsinglepage, local_custompage{{/str}}
        </button>
        <a class="btn btn-outline-secondary mr-2 me-2 mb-2" href="{{prompturl}}">
            {{#str}}downloadprompt, local_custompage{{/str}}
        </a>
        <a class="btn btn-outline-secondary mr-2 me-2 mb-2" href="{{homeurl}}">{{#str}}viewintranethome, local_custompage{{/str}}</a>
        {{#settingsurl}}
            <a class="btn btn-outline-secondary mb-2" href="{{settingsurl}}">{{#str}}intranetsettings, local_custompage{{/str}}</a>
        {{/settingsurl}}
    </div>
    <p class="text-muted">{{#str}}managehelp, local_custompage{{/str}}</p>
    {{#hasitems}}
        <table class="table generaltable local-custompage-manage-table">
            <thead>
                <tr>
                    <th scope="col">{{#str}}pagename, local_custompage{{/str}}</th>
                    <th scope="col">{{#str}}whocansee, local_custompage{{/str}}</th>
                    <th scope="col">{{#str}}upkeep, local_custompage{{/str}}</th>
                    <th scope="col">{{#str}}inmenu, local_custompage{{/str}}</th>
                    <th scope="col"><span class="sr-only visually-hidden">{{#str}}actions{{/str}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#items}}
                    {{> local_custompage/manage_row }}
                    {{#children}}
                        {{> local_custompage/manage_row }}
                    {{/children}}
                {{/items}}
            </tbody>
        </table>
    {{/hasitems}}
    {{^hasitems}}
        <div class="alert alert-info">{{#str}}nopages, local_custompage{{/str}}</div>
    {{/hasitems}}
</div>
{{#js}}
    require(['local_custompage/manage'], function(manage) {
        manage.init();
    });
{{/js}}
